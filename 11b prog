#include <stdio.h>

int main(){
    int n,f,p[50],fr[10],t[10],c[10],i,j,m,h,flt=0;

    printf("No. of pages: ");
    scanf("%d",&n);

    printf("Pages: ");
    for(i=0;i<n;i++)
        scanf("%d",&p[i]);

    printf("Frames: ");
    scanf("%d",&f);

    for(i=0;i<f;i++)
        fr[i]=-1,t[i]=c[i]=0;

    for(i=0;i<n;i++){
        for(h=-1,j=0;j<f;j++)
            if(fr[j]==p[i])
                h=j;

        if(h>=0){
            t[h]=i+1;
            c[h]++;
        }

        else{
            for(m=0,j=0;j<f;j++){
                if(fr[j]==-1){
                    m=j;
                    break;
                }

                if(c[j]<c[m] ||
                  (c[j]==c[m] && t[j]<t[m]))
 }

            fr[m]=p[i];
            t[m]=i+1;
            c[m]=1;
            flt++;
        }

        printf("%d: ",p[i]);

        for(j=0;j<f;j++)
            fr[j]<0 ? printf("- ") : printf("%d ",fr[j]);

        printf(h>=0 ? "Hit\n" : "Fault\n");
    }

    printf("Faults=%d Hits=%d\n",flt,n-flt);
}
